# Copy to backend/.env and fill in real values before deploying.
# Everything here has a working default for local development (see
# app/config.py) — this file only needs to be created when you want to
# override something (a real SECRET_KEY, real SMTP creds, etc.).

# Default matches a stock local XAMPP install (root, no password, port
# 3306). Point this at your own MySQL/MariaDB server if different — e.g.
# macOS/MAMP (root/root, port 8889 by default):
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:8889/toogood
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/toogood

SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

# Leave SMTP_HOST unset to use the console "mock" email backend (emails are
# logged instead of sent) — handy for local dev without real credentials.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=no-reply@toogood.example
# SMTP_USE_TLS=true

LICENSE_STORAGE_DIR=uploads/licenses
MAX_LICENSE_SIZE_MB=10

# Where THIS API is publicly reachable from clients — used to build real,
# working URLs for uploaded license files. Keep in sync with
# EXPO_PUBLIC_API_BASE_URL in the frontend's own .env (project root): same
# backend, same address (e.g. your machine's LAN IP for a physical device
# over Expo, or your real domain once deployed).
PUBLIC_BASE_URL=http://127.0.0.1:8000

FRONTEND_BASE_URL=http://localhost:8081

# Copia questo file in .env e compila i valori reali. Non committare mai .env.

# MySQL — formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/gran_consiglio"

PORT=3000
NODE_ENV=development

# Frontend URL usato nei link inviati via email (verifica email, reset password)
APP_BASE_URL="http://localhost:8081"

# JWT — genera segreti lunghi e casuali per produzione, es: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Token monouso (verifica email, reset password)
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Riserva temporanea dello stock quando una box entra nel carrello
CART_RESERVATION_MINUTES=10

# SMTP — in sviluppo, se non configurato, le email vengono solo stampate in console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Gran Consiglio <no-reply@example.com>"

# Funzione AI "scheda di recupero pianta" (backend Python, vedi app/plant_care.py)
# AI_PROVIDER: gemini (piano gratuito, chiave da https://aistudio.google.com) oppure anthropic.
# Senza la chiave del provider scelto l'endpoint risponde 503.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opzionale: se presente, le foto vengono identificate prima con PlantNet (https://my.plantnet.org)
PLANTNET_API_KEY=
# Copia questo file in .env e compila i valori reali. Non committare mai .env.

# Default matches a stock local XAMPP install (root, no password, port
# 3306). Point this at your own MySQL/MariaDB server if different — e.g.
# macOS/MAMP (root/root, port 8889 by default):
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:8889/toogood
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/toogood

DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

PORT=3000
NODE_ENV=development

# Frontend URL usato nei link inviati via email (verifica email, reset password)
APP_BASE_URL="http://localhost:8081"

# Leave unset to use the console "mock" push backend (app/push_utils.py —
# pushes are logged instead of sent), same idea as SMTP above. Set to the
# path of a Firebase service account JSON (Firebase console -> Project
# settings -> Service accounts -> Generate new private key) to send real
# pushes via Firebase Cloud Messaging.
# FIREBASE_CREDENTIALS_FILE=/path/to/firebase-service-account.json

LICENSE_STORAGE_DIR=uploads/licenses
MAX_LICENSE_SIZE_MB=10

# Where THIS API is publicly reachable from clients — used to build real,
# working URLs for uploaded license files. Unlike EXPO_PUBLIC_API_BASE_URL
# in the frontend's own .env (project root, now auto-detected on WiFi dev
# and usually left unset — see .env.example there), this one is NOT
# auto-detected: set it to your machine's current LAN IP (or your real
# domain once deployed) whenever it changes, or license file links will
# point at a stale address.
PUBLIC_BASE_URL=http://127.0.0.1:8000

FRONTEND_BASE_URL=http://localhost:8081

# Copia questo file in ".env" (gitignorato) e adatta l'IP.
#
# Deve essere raggiungibile dal dispositivo/simulatore su cui gira l'app:
#   - Simulatore iOS/Android su questo Mac -> http://127.0.0.1:8000
#     (emulatore Android: http://10.0.2.2:8000)
#   - Expo Go su telefono fisico, stessa WiFi del Mac -> http://<IP LAN del Mac>:8000
#     Trova l'IP con: ipconfig getifaddr en0
#   - Browser (expo start --web) -> http://127.0.0.1:8000
#
# Il backend va avviato con --host 0.0.0.0 per essere raggiungibile da un
# telefono fisico sulla stessa rete, non solo da questo Mac:
#   cd backend && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --reload
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.11:8000
